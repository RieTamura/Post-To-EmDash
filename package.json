{
	"name": "post-to-emdash",
	"version": "0.2.0",
	"description": "Send notes to an EmDash site as blog posts, with images, tags and categories.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"emdash"
	],
	"author": "RieTamura",
	"license": "0BSD",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.5",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.14.4",
		"tslib": "^2.4.0",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"moment": "^2.31.0"
	}
}
